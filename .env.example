# -----------------------------------------------------------------------------
# Task Tracker – environment configuration
# Copy to .env and adjust. Branding, SMTP and time zone can also be changed
# later by an admin in Settings (those values override the ones below).
# -----------------------------------------------------------------------------

APP_NAME="Task Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tasks.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Optional: require this secret on the first-run setup page (/setup).
# Strongly recommended when the server is reachable from the internet.
SETUP_TOKEN=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database -----------------------------------------------------------------
# MySQL / MariaDB (recommended for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=task_tracker
DB_USERNAME=task_tracker
DB_PASSWORD=

# Or SQLite for a quick trial – comment out the MySQL lines above and use:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Emails are queued in the database and sent in the background. The scheduler
# cron entry processes the queue every minute; set QUEUE_WORKER_IN_SCHEDULER=false
# if you run `php artisan queue:work` separately (e.g. with Supervisor).
QUEUE_CONNECTION=database
QUEUE_WORKER_IN_SCHEDULER=true
CACHE_STORE=database
# CACHE_PREFIX=

# --- Mail (SMTP) ----------------------------------------------------------------
# Used for task assignments, reminders, invitations and password resets.
# An admin can override these in Settings → Email (SMTP).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tasks@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage ---------------------------------------------------------------
# Uploads (task & project attachments, the company logo) go to this disk.
# Default: Cloudflare R2. Use "local" to store files on the server instead.
FILESYSTEM_DISK=r2

# Cloudflare R2 – create a bucket and an API token with Object Read & Write.
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

# Amazon S3 or any other S3-compatible storage (set FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Livewire stores in-progress uploads here before moving them to the disk above.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

VITE_APP_NAME="${APP_NAME}"
